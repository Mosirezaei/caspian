# Supabase (public — used by browser + API routes)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Alanchand currency rates API token (used by /api/cron/sync-rates)
# https://alanchand.com
ALANCHAND_API_TOKEN=your_alanchand_api_token

# Shared secret required by the Vercel/GitHub Actions cron jobs that call
# /api/cron/sync-rates and /api/cron/sync-events
CRON_SECRET=your_cron_secret

# Admin reservation dashboard (server-only; never use NEXT_PUBLIC_ prefix)
ADMIN_PASSWORD=choose_a_new_strong_password
ADMIN_SESSION_SECRET=generate_a_long_random_secret
RESERVATIONS_API_URL=https://your-project.supabase.co/functions/v1/reservations-api
RESERVATIONS_API_PASSWORD=the_new_password_configured_in_the_edge_function
